#!/usr/bin/env bash
# muxtopus -- open a Claude Code tmux session on an account, with its watchdog.
#
#   muxtopus                          session "claude" in $HOME, personal account
#   muxtopus --profile=work           the work account   (~/.claude-work)
#   muxtopus -w                       the same, shorter
#   muxtopus --profile=acme           any account        (~/.claude-acme)
#   muxtopus infra ~/src/infra        a named session in a directory
#   muxtopus -w infra ~/src/infra     both
#   muxtopus -r                       start Claude with the resume picker
#   muxtopus --restore[=FILE]         rebuild the windows a dead server took
#                                     (docs/restore.md); plain muxtopus offers it
#   muxtopus --create --profile=acme  a NEW account, without being asked first
#   muxtopus -d --profile=acme        create it and return (for scripts)
#   muxtopus -l                       list accounts, sessions and watchdogs
#   muxtopus -c [--profile=acme]      the effective configuration of an account
#   muxtopus stats [--week|--all]     what was used, counts only (stats -h)
#   muxtopus update [--check|--apply] new releases (docs/updates.md)
#   muxtopus --version                the release this checkout is (VERSION)
#
# THE NAME IS A FLAG. Symlinked as `muxtopus-acme` this is `muxtopus
# --profile=acme`: one word per account, which is what an ssh RemoteCommand
# has room for. An explicit flag still wins over the name. Shorter names are
# for a shell alias, not for PATH: `cc` on PATH is the C compiler on any
# machine with a toolchain, and `mux` is already several other tools.
#
# ONE ACCOUNT PER SESSION. A profile picks the Claude config dir, and every
# path that belongs to an account follows it: the tmux session name, the
# schedules, backups and handovers folders, the watchdog's state and its usage
# cache. The default account is unsuffixed, so `muxtopus` with no flag uses exactly
# the paths a single-account machine has always used.
#
# The config dir is exported into the tmux SESSION (-e), not merely into this
# process, so every window opened later -- by hand, by the dashboard, or by the
# watchdog launching a scheduled window -- inherits the right account instead
# of quietly falling back to the default one.
set -uo pipefail

# Inside a Flatpak sandbox (VSCode's integrated terminal) the tmux server is
# NOT the host's -- its socket lives in the sandbox's private /tmp. Re-exec on
# the host so every client shares one server.
if [ -f /.flatpak-info ] && command -v flatpak-spawn >/dev/null 2>&1; then
  # readlink -f resolves the symlink back to `muxtopus`, throwing away the
  # name it was invoked by -- and the name is the account. Carry it across
  # explicitly, or `muxtopus-work` inside VSCode's terminal would quietly open
  # the personal session.
  export MUX_ARGV0="${MUX_ARGV0:-$(basename -- "$0")}"
  exec flatpak-spawn --host --env=MUX_ARGV0="$MUX_ARGV0" "$(readlink -f "$0")" "$@"
fi

export PATH="$HOME/.local/bin:$PATH"

# Find the checkout. The config file pins it for a COPIED install; otherwise
# this script's own resolved location is right for a symlinked one.
_self="$(readlink -f "$0")"
MUXTOPUS_CONFIG="${MUXTOPUS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/muxtopus/config}"
# shellcheck disable=SC1090
[ -f "$MUXTOPUS_CONFIG" ] && . "$MUXTOPUS_CONFIG"
_dir="${MUXTOPUS_DIR:-$(dirname "$_self")}"
if [ ! -f "$_dir/profile.sh" ]; then
  echo "muxtopus: cannot find profile.sh next to $_self or at MUXTOPUS_DIR=$_dir" >&2
  echo "     set MUXTOPUS_DIR in $MUXTOPUS_CONFIG" >&2
  exit 1
fi
# shellcheck disable=SC1091
. "$_dir/profile.sh"

# The account this was INVOKED as: a link named muxtopus-<account>. One
# pattern, no table to extend.
_argv0="${MUX_ARGV0:-$(basename -- "$0")}"
NAME_PROFILE=""
case "$_argv0" in
  muxtopus-*) NAME_PROFILE="${_argv0#muxtopus-}" ;;
esac
case "$NAME_PROFILE" in *[!a-zA-Z0-9_-]*) NAME_PROFILE="" ;; esac

RESUME=""; PROFILE=""; DETACH=0; NOWD=0; LIST=0; SHOWCFG=0; CREATE=0; RESTORE=0; RESTORE_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -r|--resume)       RESUME="--resume"; shift ;;
    --restore)         RESTORE=1; shift ;;
    --restore=*)       RESTORE=1; RESTORE_FILE="${1#--restore=}"; shift ;;
    -w|--work)         PROFILE="work"; shift ;;
    --profile=*)       PROFILE="${1#--profile=}"; shift ;;
    -P|--profile)      [ -n "${2:-}" ] || { echo "muxtopus: --profile needs a name" >&2; exit 2; }
                       PROFILE="$2"; shift 2 ;;
    -d|--detach)       DETACH=1; shift ;;
    --create)          CREATE=1; shift ;;
    -n|--no-watchdog)  NOWD=1; shift ;;
    -l|--list)         LIST=1; shift ;;
    -c|--config)       SHOWCFG=1; shift ;;
    -V|--version)      cat "$_dir/VERSION" 2>/dev/null || echo "?"; exit 0 ;;
    -h|--help)         sed -n '2,25p' "$0"; exit 0 ;;
    --)                shift; break ;;
    -*)                echo "muxtopus: unknown option: $1" >&2; exit 2 ;;
    *)                 break ;;
  esac
done

[ -n "$PROFILE" ] || PROFILE="$NAME_PROFILE"
# A profile name becomes a path segment (~/.claude-<name>, profiles/<name>.conf)
# and a tmux session name, so it is letters, digits, - and _ or nothing.
case "$PROFILE" in *[!a-zA-Z0-9_-]*) echo "muxtopus: bad profile name: $PROFILE" >&2; exit 2 ;; esac

# --------------------------------------------------------------- snapshot
# THE WINDOWS A DEAD SERVER TOOK (docs/restore.md). The watchdog freezes its
# last window snapshot as $MUX_STATE/windows.last.tsv when the session is
# gone; these read it, and `claude-watchdog.sh --restore` rebuilds from it.
mux_snapshot_rows() { grep -vc '^#' "$1" 2>/dev/null || echo 0; }
mux_snapshot_seen() {  # the epoch the session was last seen, from the header
  awk -F'\t' 'NR==1{ if ($1=="#lost") print $3; else if ($1=="#seen") print $2; exit }' "$1" 2>/dev/null
}
mux_snapshot_when() { date -d "@$(mux_snapshot_seen "$1")" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?'; }
# One phrase for `muxtopus -l`: what snapshot this account has, if any.
mux_snapshot_line() {
  local f
  if [ -f "$MUX_STATE/windows.last.tsv" ]; then
    f="$MUX_STATE/windows.last.tsv"
    printf '%s windows, frozen at %s' "$(mux_snapshot_rows "$f")" "$(mux_snapshot_when "$f")"
  elif [ -f "$MUX_STATE/windows.declined.tsv" ]; then
    f="$MUX_STATE/windows.declined.tsv"
    printf '%s windows, declined (%s)' "$(mux_snapshot_rows "$f")" "$(mux_snapshot_when "$f")"
  elif [ -f "$MUX_STATE/windows.tsv" ]; then
    printf '%s windows, live' "$(mux_snapshot_rows "$MUX_STATE/windows.tsv")"
  else
    printf -- '-'
  fi
}

# ------------------------------------------------------------------ stats
# The insights report on the command line: muxstats.py reads the account's
# ledger (collecting what is new first) and prints it. Taken BEFORE anything
# that touches tmux, a watchdog or a config dir -- a report needs none of
# them. The word is therefore reserved: a session cannot be named `stats`
# from here.
if [ "${1:-}" = "stats" ]; then
  shift
  # The config is loaded for its INTERPRETER and nothing else: muxstats.py
  # resolves the account itself from --profile, and this has to run on the
  # machine whose python3 is 3.9 as well as the one whose is not.
  mux_load_config ""
  exec "$MUX_PYTHON" "$_dir/muxstats.py" stats --profile "$PROFILE" "$@"
fi

# ------------------------------------------------------------------ update
# New releases, on the command line: the same script the watchdog runs on its
# daily clock and the dashboard's Settings > Updates drives. Taken here, before
# tmux or a config dir is touched, for the same reason `stats` is -- checking
# whether there is a newer muxtopus needs neither -- and the word is reserved
# with it, so a session cannot be named `update` from here.
#
#   muxtopus update              what is installed, what is out
#   muxtopus update --check      ask now, whatever the clock says
#   muxtopus update --apply      take it (asks first; --yes does not)
#   muxtopus update --rollback   put back the tree the last one replaced
if [ "${1:-}" = "update" ]; then
  shift
  case "${1:-}" in
    ""|--status) set -- --status ;;
    --check)     shift; set -- --check --force "$@" ;;
  esac
  exec bash "$_dir/mux-update.sh" ${PROFILE:+--profile "$PROFILE"} "$@"
fi

# ----------------------------------------------------------------- config
if [ "$SHOWCFG" = 1 ]; then
  mux_show_config "$PROFILE"
  exit 0
fi

# ------------------------------------------------------------------- list
if [ "$LIST" = 1 ]; then
  printf '%-12s %-24s %-10s %-22s %s\n' ACCOUNT SESSION LOGGED-IN WATCHDOG SNAPSHOT
  while IFS= read -r p; do
    mux_use_profile "$p"
    sess="-"
    mux_tmux has-session -t "=$MUX_TMUX" 2>/dev/null && \
      sess="$MUX_TMUX ($(mux_tmux list-windows -t "=$MUX_TMUX" 2>/dev/null | wc -l)w)"
    login="no"; [ -f "$MUX_CONFIG_DIR/.credentials.json" ] && login="yes"
    wd="off"
    if systemctl --user is-active --quiet "$MUX_UNIT" 2>/dev/null; then
      wd="running"; [ -f "$MUX_STATE/enabled" ] || wd="running (disarmed)"
    elif kill -0 "$(cat "$(mux_run_dir)/muxtopus-wd$MUX_SUFFIX.pid" 2>/dev/null)" 2>/dev/null; then
      wd="running (no systemd)"
    fi
    printf '%-12s %-24s %-10s %-22s %s\n' "$MUX_LABEL" "$sess" "$login" "$wd" "$(mux_snapshot_line)"
  done < <(mux_profiles)
  exit 0
fi

mux_use_profile "$PROFILE"
mux_export_config_dir
mux_tmux_env

# NO `claude`, NO SESSION. Without this, a machine with no claude got a tmux
# session with a dashboard in one window and, in the other, "bash: claude:
# command not found" above a bare prompt -- and the watchdog up behind it,
# ready to restart that window into the same message. One line here says
# which thing is wrong. A claude that is only OFF PATH is not this case:
# Claude Code's own installer puts it in ~/.local/bin, and the export at the
# top of this file puts that directory in front of everything this script
# and its windows run, whatever the calling shell's PATH said.
if ! command -v claude >/dev/null 2>&1; then
  echo "muxtopus: claude is not installed -- https://docs.claude.com/en/docs/claude-code" >&2
  exit 1
fi

# A NEW ACCOUNT IS A QUESTION, NOT A SIDE EFFECT. Creating one makes a config
# dir, three data folders and a systemd unit -- and a typo in --profile used
# to do all of that silently. So an account that does not exist yet is
# confirmed at a terminal, or requested outright with --create where there is
# no terminal (a script, an ssh RemoteCommand); otherwise nothing is touched.
if [ ! -d "$MUX_CONFIG_DIR" ]; then
  if [ "$CREATE" != 1 ]; then
    have="$(mux_profiles | sed 's/^$/personal/' | paste -sd' ' -)"
    echo "muxtopus: there is no account '$MUX_LABEL' ($MUX_CONFIG_DIR)." >&2
    echo "          accounts on this machine: ${have:-none}" >&2
    if [ -t 0 ] && [ -t 2 ]; then
      printf 'create it? %s, %s/{schedules,backups,handovers} and a disarmed watchdog [y/N] '         "$MUX_CONFIG_DIR" "$MUX_HOME" >&2
      read -r ans
      case "$ans" in y|Y|yes|YES) ;; *) echo "muxtopus: nothing created." >&2; exit 1 ;; esac
    else
      echo "          no terminal to ask on; pass --create to make it." >&2
      exit 1
    fi
  fi
  mkdir -p "$MUX_CONFIG_DIR"
  echo "muxtopus: created $MUX_CONFIG_DIR -- Claude will ask you to log in." >&2
  # A new account gets its config file, every key commented at its default,
  # so what can be tuned for it is on disk from day one rather than in a doc.
  if [ -n "$MUX_PROFILE" ] && [ ! -f "$MUX_PROFILE_CONF" ]; then
    mkdir -p "$(dirname "$MUX_PROFILE_CONF")"
    mux_config_template "$MUX_PROFILE" > "$MUX_PROFILE_CONF"
    echo "muxtopus: wrote $MUX_PROFILE_CONF (all defaults, commented)" >&2
  fi
fi
mux_ensure_dirs

# --------------------------------------------------------------- watchdog
# Brought up with the session, because a session without one is exactly the
# situation the watchdog exists for: a window that stops at a usage limit and
# never restarts. Installed on first use per account and left alone after.
#
# DISARMED WHEN THE ACCOUNT HAS NOT LOGGED IN. Arming it then would have it
# restart windows into a login screen, and its usage probe would start a
# doomed session every hour.
watchdog_up() {
  local wd="$_dir/claude-watchdog.sh"
  [ -x "$wd" ] || return 0

  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    if [ ! -f "$HOME/.config/systemd/user/$MUX_UNIT" ]; then
      echo "muxtopus: installing the watchdog for '$MUX_LABEL'..." >&2
      if [ -n "$MUX_PROFILE" ]; then "$wd" --profile "$MUX_PROFILE" --install >/dev/null
      else "$wd" --install >/dev/null; fi
      [ -f "$MUX_CONFIG_DIR/.credentials.json" ] || {
        if [ -n "$MUX_PROFILE" ]; then "$wd" --profile "$MUX_PROFILE" --off >/dev/null
        else "$wd" --off >/dev/null; fi
        echo "muxtopus: watchdog installed but DISARMED until '$MUX_LABEL' logs in." >&2
        echo "     arm it with:  w  on the dashboard" >&2
      }
    fi
    systemctl --user is-active --quiet "$MUX_UNIT" 2>/dev/null || \
      systemctl --user start "$MUX_UNIT" >/dev/null 2>&1
    return 0
  fi

  # NO SYSTEMD (macOS, WSL, a container, a bare login). Run the daemon as an
  # ordinary background process instead of doing nothing: the whole promise of
  # this tool is that a limited window comes back, and that must not depend on
  # which init the machine happens to use.
  # The pid file lives where mux_run_dir says (profile.sh: not root's runtime
  # dir after `su`, not a shared /tmp). A pid in it counts only while it is a
  # watchdog: after a reboot the same number is whatever got it next.
  local pidf pid
  pidf="$(mux_run_dir)/muxtopus-wd$MUX_SUFFIX.pid"
  pid="$(cat "$pidf" 2>/dev/null)"
  if [ -n "$pid" ] && ps -o args= -p "$pid" 2>/dev/null | grep -q 'claude-watchdog'; then
    return 0
  fi
  # WITHOUT $TMUX, as systemd would start it. Run from inside a pane,
  # muxtopus has the $TMUX of whatever server that pane is on -- a sandbox's,
  # a nested one's -- and tmux follows $TMUX before TMUX_TMPDIR or the default
  # socket, so a daemon that inherited it would drive that server for good.
  if [ -n "$MUX_PROFILE" ]; then
    nohup env -u TMUX -u TMUX_PANE "$wd" --profile "$MUX_PROFILE" --daemon >/dev/null 2>&1 &
  else
    nohup env -u TMUX -u TMUX_PANE "$wd" --daemon >/dev/null 2>&1 &
  fi
  pid=$!
  echo "$pid" > "$pidf" 2>/dev/null \
    || echo "muxtopus: cannot write $pidf; the next run will start a second watchdog" >&2
  echo "muxtopus: watchdog started in the background (no systemd here); pid $pid" >&2
}
[ "$NOWD" = 1 ] || watchdog_up

# ---------------------------------------------------------------- session
# A NAMED session is suffixed too. That is the point of the exercise: two
# accounts working the same repo would otherwise both want the session
# `infra`, and whichever got there first would silently adopt the other's
# windows -- under the wrong credentials.
SESSION="${1:-${MUXTOPUS_SESSION_PREFIX:-claude}}"
[ -n "$MUX_SUFFIX" ] && SESSION="$SESSION$MUX_SUFFIX"
DIR="${2:-$HOME}"

STATUS="$_dir/deck-status.sh"
STATUS_CMD="if [ -x \"$STATUS\" ]; then \"$STATUS\"; else echo 'dashboard not found'; exec bash; fi; exec bash"

# WHAT TO REBUILD, if anything (docs/restore.md). --restore names it outright.
# Otherwise: no session, a frozen snapshot younger than WATCHDOG_RESTORE_MAX_AGE
# hours, and WATCHDOG_RESTORE decides -- `ask` at a terminal (never under -d:
# a script cannot answer), `auto` without asking, `off` never. A declined
# snapshot is renamed so it is not asked about again; --restore=<path> still
# takes it. The check comes AFTER the watchdog is up, because the daemon is
# what keeps the record and what will rebuild it.
RESTORE_FROM=""
_snap="$MUX_STATE/windows.last.tsv"
if [ "$RESTORE" = 1 ]; then
  RESTORE_FROM="${RESTORE_FILE:-$_snap}"
  [ -f "$RESTORE_FROM" ] || { echo "muxtopus: no snapshot at $RESTORE_FROM" >&2; exit 1; }
elif ! mux_tmux has-session -t "=$SESSION" 2>/dev/null && [ -f "$_snap" ] \
     && [ "$SESSION" = "$MUX_TMUX" ]; then
  _seen="$(mux_snapshot_seen "$_snap")"
  _age=$(( $(date +%s) - ${_seen:-0} ))
  _k="$(mux_snapshot_rows "$_snap")"; _when="$(mux_snapshot_when "$_snap")"
  if [ "$_age" -le $(( ${WATCHDOG_RESTORE_MAX_AGE:-24} * 3600 )) ] && [ "$_k" -gt 0 ]; then
    case "${WATCHDOG_RESTORE:-ask}" in
      auto) RESTORE_FROM="$_snap"
            echo "muxtopus: WATCHDOG_RESTORE=auto -- restoring $_k windows frozen at $_when" >&2 ;;
      off)  ;;
      *)    if [ "$DETACH" != 1 ] && [ -t 0 ] && [ -t 2 ]; then
              printf 'muxtopus: the tmux session is gone but the watchdog kept its windows.\n' >&2
              printf '          restore %s windows from %s? [Y/n] ' "$_k" "$_when" >&2
              read -r ans
              case "$ans" in n|N|no|NO) mv "$_snap" "$MUX_STATE/windows.declined.tsv"
                                        echo "muxtopus: not restored; kept as windows.declined.tsv (muxtopus --restore=<path> takes it)" >&2 ;;
                             *) RESTORE_FROM="$_snap" ;;
              esac
            else
              echo "muxtopus: a frozen snapshot of $_k windows ($_when) is waiting -- muxtopus --restore puts them back" >&2
            fi ;;
    esac
  fi
fi

if ! mux_tmux has-session -t "=$SESSION" 2>/dev/null; then
  # A NEW session gets two windows: 0 = the live dashboard (the landing page),
  # 1 = Claude. Attaching lands on 0, so the state of the machine is the first
  # thing you see; Ctrl-b 1 switches to Claude. Re-attaching to an existing
  # session returns you to whichever window you left, untouched.
  #
  # 'exec bash' keeps each window alive if its program exits, so a stray Ctrl-C
  # never destroys the session.
  mux_tmux new-session -d -s "$SESSION" -c "$DIR" -n status \
    "${MUX_TMUX_ENV[@]}" \
    "$STATUS_CMD"
  # The DEFAULT account must find no CLAUDE_CONFIG_DIR in the session either.
  # The server's environment outlives any one session, so a variable left there
  # by an earlier account would be handed to every window opened here.
  [ -n "$MUX_PROFILE" ] || mux_tmux set-environment -u -t "=$SESSION" CLAUDE_CONFIG_DIR 2>/dev/null
  # A RESTORE brings the claude windows itself, the real ones with their
  # sessions; only a fresh start gets the default one.
  [ -n "$RESTORE_FROM" ] || mux_tmux new-window -t "=$SESSION" -c "$DIR" -n claude \
    "${MUX_TMUX_ENV[@]}" \
    "claude $RESUME; exec bash"
  mux_tmux select-window -t "=$SESSION:0"
else
  # The dashboard was QUIT: its window fell through to the 'exec bash' above
  # and sits at a bare prompt. Running muxtopus again is the way back, so
  # bring the dashboard up in that window again. Only a shell is replaced --
  # anything else running there was put there on purpose.
  # The dashboard is looked for by name, not by pane_current_command: its bash
  # renderer (no venv) is a "bash" too, as is the muxtopus typed at the prompt.
  _pp="$(mux_tmux display-message -p -t "=$SESSION:status" '#{pane_pid}' 2>/dev/null)"
  _pc="$(mux_tmux display-message -p -t "=$SESSION:status" '#{pane_current_command}' 2>/dev/null)"
  if [ -n "$_pp" ] && ! ps -o args= -p "$_pp" 2>/dev/null | grep -q 'deck[-_]status' \
     && ! pgrep -P "$_pp" -f 'deck[-_]status' >/dev/null 2>&1; then
    case "$_pc" in
      bash|sh|zsh|fish|dash|muxtopus*)
        mux_tmux respawn-pane -k -t "=$SESSION:status" -c "$DIR" "${MUX_TMUX_ENV[@]}" "$STATUS_CMD" 2>/dev/null ;;
    esac
  fi
fi

# THE REBUILD, into the session that now exists: the watchdog's own recipe,
# window by window (claude-watchdog.sh --restore). Its summary is printed
# here; the detail is in the watchdog's log.
if [ -n "$RESTORE_FROM" ]; then
  if [ -n "$MUX_PROFILE" ]; then "$_dir/claude-watchdog.sh" --profile "$MUX_PROFILE" --restore "$RESTORE_FROM"
  else "$_dir/claude-watchdog.sh" --restore "$RESTORE_FROM"; fi
  _rrc=$?
  [ "$_rrc" = 0 ] || echo "muxtopus: the restore had trouble (exit $_rrc); see $MUX_STATE/log" >&2
fi

if [ "$DETACH" = 1 ]; then
  echo "$SESSION"
  exit 0
fi
# INSIDE tmux already -- typed at the prompt Quit leaves behind, or from
# another session's window -- attaching would nest a client in a pane and tmux
# refuses ("sessions should be nested with care"). Move this client instead.
if [ -n "${TMUX:-}" ]; then
  mux_tmux select-window -t "=$SESSION:status" 2>/dev/null
  mux_tmux_exec switch-client -t "=$SESSION"
fi
mux_tmux_exec attach-session -t "=$SESSION"
