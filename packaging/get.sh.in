#!/usr/bin/env bash
# get.sh -- install muxtopus @VERSION@: exactly that release, and nothing newer.
#
#   curl -fsSL https://github.com/AlexZ005/Muxtopus/releases/download/v@VERSION@/get.sh | bash
#   curl -fsSL .../get.sh | bash -s -- --no-watchdog    (install.sh's options pass through)
#
# Or read it first, which is the better habit for a thing that installs a
# daemon that types into your terminals:
#
#   curl -fsSLO https://github.com/AlexZ005/Muxtopus/releases/download/v@VERSION@/get.sh
#   less get.sh && bash get.sh
#
# WHAT IT DOES, AND ALL IT DOES:
#   1. downloads muxtopus-@VERSION@.tar.gz from the v@VERSION@ release;
#   2. refuses it unless its sha256 is the one below, computed when this file
#      was built from the tag -- so a moved tag or a swapped asset is an error,
#      not an install;
#   3. unpacks it into ~/.local/lib/muxtopus (MUXTOPUS_LIB overrides), replacing
#      an earlier release there but keeping its .venv, and refusing to touch a
#      directory it did not put there (a git checkout, say);
#   4. runs that tree's install.sh, which prints every path before it writes it.
# Nothing outside your home directory, and no sudo.
#
# Generated by release.sh from packaging/get.sh.in. VERSION is the only place
# the number is written; this file is stamped with it at release time.

# Everything is inside main, called on the last line: a download cut off half
# way is a syntax error, never half an installer that ran.
main() {
  set -euo pipefail
  local version="@VERSION@" sha="@SHA256@"
  local url="${MUXTOPUS_TARBALL:-https://github.com/AlexZ005/Muxtopus/releases/download/v$version/muxtopus-$version.tar.gz}"
  local lib="${MUXTOPUS_LIB:-$HOME/.local/lib/muxtopus}"
  local tmp got old

  say()  { printf '\033[1m==> %s\033[0m\n' "$*"; }
  die()  { printf '\033[31mget.sh: %s\033[0m\n' "$*" >&2; exit 1; }

  command -v tar >/dev/null || die "tar is missing"
  command -v gzip >/dev/null || die "gzip is missing"
  if [ -e "$lib" ] && [ ! -f "$lib/.muxtopus-release" ]; then
    [ -e "$lib/.git" ] && die "$lib is a git checkout: update it with git, or set MUXTOPUS_LIB"
    [ -z "$(ls -A "$lib" 2>/dev/null)" ] \
      || die "$lib exists and was not made by get.sh; move it, or set MUXTOPUS_LIB"
  fi

  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf -- '${tmp:?}'" EXIT

  say "muxtopus $version"
  echo "    from $url"
  echo "    into $lib"
  if command -v curl >/dev/null; then
    curl -fsSL "$url" -o "$tmp/src.tar.gz" || die "download failed: $url"
  elif command -v wget >/dev/null; then
    wget -qO "$tmp/src.tar.gz" "$url" || die "download failed: $url"
  else
    die "neither curl nor wget is here"
  fi

  if command -v sha256sum >/dev/null; then
    got="$(sha256sum "$tmp/src.tar.gz" | cut -d' ' -f1)"
  elif command -v shasum >/dev/null; then
    got="$(shasum -a 256 "$tmp/src.tar.gz" | cut -d' ' -f1)"
  else
    die "no sha256sum or shasum to check the download with"
  fi
  [ "$got" = "$sha" ] || die "checksum mismatch: expected $sha, got $got -- not installing"
  echo "    sha256 $got  ok"

  tar -xzf "$tmp/src.tar.gz" -C "$tmp"
  [ -f "$tmp/muxtopus-$version/install.sh" ] || die "the tarball has no muxtopus-$version/install.sh"
  echo "$version" > "$tmp/muxtopus-$version/.muxtopus-release"

  # Same final path, so a venv carried across still resolves; install.sh
  # rebuilds it if the python it was made from has gone.
  if [ -d "$lib/.venv" ]; then
    mv "$lib/.venv" "$tmp/muxtopus-$version/.venv"
  fi
  mkdir -p "$(dirname "$lib")"
  if [ -e "$lib" ]; then
    # THE TREE BEING REPLACED IS KEPT, one deep, as $lib.prev. A release that
    # breaks this machine is then one move back -- `muxtopus update
    # --rollback`, or by hand -- instead of a hunt for the old tag and a
    # second download on a machine whose dashboard has stopped working. The
    # one before it goes; two generations is a hoard, not insurance.
    # It has no .venv: that was carried forward above, because it belongs to
    # the PATH and to the python that built it. A rollback moves it back.
    if [ -e "$lib.prev" ]; then
      old="$lib.prev.old.$$"
      mv "$lib.prev" "$old"
    fi
    mv "$lib" "$lib.prev"
    mv "$tmp/muxtopus-$version" "$lib"
    if [ -n "${old:-}" ]; then rm -rf -- "${old:?}"; fi
  else
    mv "$tmp/muxtopus-$version" "$lib"
  fi

  say "running $lib/install.sh $*"
  bash "$lib/install.sh" "$@"
}

main "$@"
