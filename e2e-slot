#!/usr/bin/env bash
# e2e-slot -- run an e2e command in one of N machine-wide Playwright slots.
#
#   e2e-slot [--exclusive] [--local] [--pc-first SECS] [--wait SECS] [--dev <dir> <port>] -- <command...>
#
# HOW MANY: MUXTOPUS_E2E_SLOTS (default 2; Settings ▸ Budget ▸ on the
# dashboard, or the config file), and E2E_SLOTS in the environment beats it
# for one run. Slot A is the classic /tmp/tp-e2e.lock, so old-style
# `flock /tmp/tp-e2e.lock` users share slot A; slot B is /tmp/tp-e2e.lock.b,
# C .c and so on. --exclusive holds EVERY slot (use it for fps/timing
# measurements). The command sees E2E_SLOT=A, B, ... or AB... for exclusive.
# Exit 75 when no slot came free within --wait seconds (default 5400).
#
# WHY A KNOB. Two was right for the box it was written on (a 30 GB Deck,
# where a third Playwright run pushed it into swap); a bigger machine can take
# more, and a lane budget that allows twelve lanes queues most of them here.
#
# REMOTE SLOTS. MUXTOPUS_E2E_REMOTE ("host:port,host:port", E2E_REMOTE for
# one run) adds one slot per entry, named after the local ones (D, E, ... with
# three local slots), whose BROWSER runs on that host. The test, its node and
# the dev server stay here; lib/pw-remote-shim.cjs (put in NODE_OPTIONS with
# PW_REMOTE_WS) turns the test's chromium.launch() into a connect to the
# Playwright server there (lib/pw-remote-server.cjs), so no test changes. The
# same host:port twice is two slots on one server. Why: on the Deck the
# browsers are what fill RAM -- 19 of 29 GB and 11 of 15 GB swap with three
# local slots on the day this was added -- so the slots could not grow here.
#
# A remote slot is handed out only after its host answers (GET /json within
# a few seconds); a host that does not -- the PC asleep -- is skipped for a
# minute and the run takes a local slot as before. MUXTOPUS_E2E_PREFER
# (remote, the default, or local) says which kind a run tries first when both
# are free: remote saves the Deck's RAM. --local never takes a remote slot,
# for a caller that must not leave the machine; --exclusive implies it, and
# still holds the remote slots too, so a timing run has the Deck to itself
# (a remote run's node and dev server are still here). The command sees
# E2E_SLOT_REMOTE=host:port on a remote slot, empty otherwise.
#
# MUXTOPUS_E2E_REMOTE_GPU (keep, the default, or d3d11; E2E_REMOTE_GPU for one
# run) is what a remote slot's browser host does with a test's Linux GPU
# flags. A test picks its ANGLE backend from THIS machine's platform, so it
# asks for Vulkan; on a Windows host that gives WebGL but no WebGPU adapter.
# d3d11 is exported to the command as PW_REMOTE_GPU, and the shim swaps
# --use-angle=vulkan for --use-angle=d3d11 (docs/remote-e2e.md has the
# measurements). A launch that asks for no GPU is never changed.
#
# PC SLOTS. MUXTOPUS_E2E_PC ("pc", "pc:2,gpu-box"; E2E_PC for one run) adds
# slots on which the WHOLE run happens on another machine -- tree, node_modules,
# dev server, test and browser -- named by hosts.conf (lib/hosts.sh), with
# "name:n" or the host's e2e_slots saying how many. lib/e2e-pc.sh does it and
# its header says how; the caller's command does not change. They come after
# the remote slots in the letters, and first in the order when PREFER is
# remote (a pc run leaves nothing on this machine, a remote one its node and
# server). --local and --exclusive never take one, and --exclusive does not
# hold them: nothing of a pc run is on this machine to disturb a timing run.
# A pc host is probed like a remote one (asked again a minute after it did
# not answer), and a run the pc host cannot take -- its tree is a checkout of
# that machine's own, a dev server port is taken there -- takes another slot.
# The command sees E2E_SLOT_PC=<name> there.
#
# --pc-first SECS waits up to SECS for a PC slot before it takes any other.
# For a battery half: three hours of node + Chromium on the Deck is the load
# that starves every other lane's run there (MEASURED on 2026-10-23: three
# local reds that were starvation, green on pc), while a pc slot frees in
# minutes once a sibling's suite ends. A pc host that does not answer ends
# the wait at once -- waiting SECS for a sleeping machine is the wrong trade.
# --local and --exclusive ignore it.
#
# --dev <dir> <port> starts that folder's dev server with `lane-dev` once the
# slot is held, runs the command, and stops the server afterwards -- unless it
# was already running before, in which case it is left as it was (its own idle
# timer still stops it). A server is up only while a run needs it. Why that
# matters is in lane-dev's header.
#
# E2E_SLOT_LOCK moves the two lock files (default /tmp/tp-e2e.lock and
# its .b). It was written for one project's lanes, and those lanes and their
# scripts already name these paths.
set -uo pipefail
EXCL=0; LOCAL=0; WAIT=5400; DEV_DIR=""; DEV_PORT=""; PCFIRST=0
while [ $# -gt 0 ]; do
  case "$1" in
    # The header above IS the help. Without this, `e2e-slot --help` took a
    # slot and ran `--help` as the command there (rc 127).
    -h|--help) sed -n '2,/^set -uo/{/^#/s/^# \{0,1\}//p}' "$0"; exit 0 ;;
    --exclusive) EXCL=1; LOCAL=1; shift ;;
    --local) LOCAL=1; shift ;;
    --wait) WAIT="$2"; shift 2 ;;
    --pc-first) PCFIRST="${2:-}"; shift 2
                case "$PCFIRST" in ''|*[!0-9]*) echo "e2e-slot: --pc-first takes seconds" >&2; exit 2 ;; esac ;;
    --dev) [ $# -ge 3 ] || { echo "e2e-slot: --dev takes <dir> <port>" >&2; exit 2; }
           DEV_DIR="$2"; DEV_PORT="$3"; shift 3 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: e2e-slot [--exclusive] [--local] [--pc-first S] [--wait S] [--dev DIR PORT] -- cmd" >&2; exit 2; }
HERE="$(dirname "$(readlink -f "$0")")"
# The configured knobs, through profile.sh like every other knob, in one
# subshell -- read only when the environment does not say, and a broken or
# missing profile.sh is the old two local slots, never an error.
# shellcheck disable=SC1091
{ IFS= read -r CFG_SLOTS; IFS= read -r CFG_REMOTE; IFS= read -r CFG_PREFER; IFS= read -r CFG_PC; IFS= read -r CFG_GPU; } < <(
  . "$HERE/profile.sh" >/dev/null 2>&1
  printf '%s\n%s\n%s\n%s\n%s\n' "${MUXTOPUS_E2E_SLOTS:-}" "${MUXTOPUS_E2E_REMOTE:-}" "${MUXTOPUS_E2E_PREFER:-}" "${MUXTOPUS_E2E_PC:-}" \
    "${MUXTOPUS_E2E_REMOTE_GPU:-}" )
N="${E2E_SLOTS:-$CFG_SLOTS}"
case "$N" in ''|*[!0-9]*|0) N=2 ;; esac
[ "$N" -gt 26 ] && N=26
# Remote entries: host:port, comma- or space-separated; "-" or empty is none.
# E2E_REMOTE="" in the environment turns them off for one run.
REMOTES=()
if [ "${E2E_REMOTE+set}" = set ]; then RSPEC="$E2E_REMOTE"; else RSPEC="$CFG_REMOTE"; fi
[ "$RSPEC" = - ] && RSPEC=""
for r in ${RSPEC//,/ }; do
  case "$r" in
    *:*[!0-9]*|*:) echo "e2e-slot: ignoring remote slot '$r' (want host:port)" >&2 ;;
    ?*:[0-9]*) REMOTES+=("$r") ;;
    *) echo "e2e-slot: ignoring remote slot '$r' (want host:port)" >&2 ;;
  esac
done
[ $((N + ${#REMOTES[@]})) -gt 26 ] && REMOTES=("${REMOTES[@]:0:$((26 - N))}")
R=${#REMOTES[@]}
# What a remote slot's host does with Vulkan GPU flags: keep them, or d3d11.
REMOTE_GPU="${E2E_REMOTE_GPU-$CFG_GPU}"
case "$REMOTE_GPU" in
  ''|-|keep) REMOTE_GPU="" ;;
  d3d11) ;;
  *) echo "e2e-slot: ignoring remote GPU setting '$REMOTE_GPU' (want keep or d3d11)" >&2; REMOTE_GPU="" ;;
esac
# PC entries: name or name:count, names from hosts.conf. E2E_PC="" turns them
# off for one run, like E2E_REMOTE.
PCS=()
if [ "${E2E_PC+set}" = set ]; then PSPEC="$E2E_PC"; else PSPEC="$CFG_PC"; fi
[ "$PSPEC" = - ] && PSPEC=""
PC_LIB="$HERE/lib/e2e-pc.sh"
if [ -n "$PSPEC" ]; then
  if [ -x "$PC_LIB" ]; then
    # shellcheck source=lib/hosts.sh
    . "$HERE/lib/hosts.sh"
    for p in ${PSPEC//,/ }; do
      pname="${p%%:*}"; pn=""
      [ "$pname" != "$p" ] && pn="${p#*:}"
      [ -n "$pn" ] || pn="$(mux_host_get "$pname" e2e_slots 1)"
      case "$pname" in ''|*[!A-Za-z0-9_.-]*) echo "e2e-slot: ignoring pc slot '$p' (want name or name:n)" >&2; continue ;; esac
      case "$pn" in ''|*[!0-9]*|0) echo "e2e-slot: ignoring pc slot '$p' (its count is not a number)" >&2; continue ;; esac
      if [ -z "$(mux_host_get "$pname" ssh)" ]; then
        echo "e2e-slot: pc host '$pname' has no ssh = in $MUX_HOSTS_FILE; skipping it" >&2; continue
      fi
      for (( k = 1; k <= pn; k++ )); do PCS+=("$pname:$k"); done
    done
  else
    echo "e2e-slot: $PC_LIB is missing; pc slots are off" >&2
  fi
fi
[ $((N + ${#REMOTES[@]} + ${#PCS[@]})) -gt 26 ] && PCS=("${PCS[@]:0:$((26 - N - ${#REMOTES[@]}))}")
P=${#PCS[@]}
PREFER="${E2E_PREFER:-$CFG_PREFER}"
[ "$PREFER" = local ] || PREFER=remote
SHIM="$HERE/lib/pw-remote-shim.cjs"
if [ "$R" -gt 0 ] && [ ! -f "$SHIM" ]; then
  echo "e2e-slot: $SHIM is missing; remote slots are off" >&2; R=0; REMOTES=()
fi
A="${E2E_SLOT_LOCK:-/tmp/tp-e2e.lock}"
# Slot i's name and lock: A is the bare path, the rest a suffix -- which is
# what the two-slot version called slot B (.b), so both versions on one
# machine share the same two files.
LETTERS=ABCDEFGHIJKLMNOPQRSTUVWXYZ
slot_name() { printf '%s' "${LETTERS:$1:1}"; }
slot_lock() { if [ "$1" = 0 ]; then printf '%s' "$A"; else printf '%s.%s' "$A" "$(slot_name "$1" | tr A-Z a-z)"; fi; }
# A remote slot's lock is named by its place in the remote list, not by its
# letter: the letters follow the local count, which E2E_SLOTS changes for one
# run, and a remote run must never share a lock with a local slot.
remote_lock() { printf '%s.remote%s' "$A" "$(( $1 + 1 ))"; }
for (( i = 0; i < N; i++ )); do touch "$(slot_lock "$i")"; done
for (( j = 0; j < R; j++ )); do touch "$(remote_lock "$j")"; done
# A pc slot's lock is named by host and number, for the same reason.
pc_lock() { local e="${PCS[$1]}"; printf '%s.pc-%s-%s' "$A" "${e%:*}" "${e##*:}"; }
for (( j = 0; j < P; j++ )); do touch "$(pc_lock "$j")"; done
# lane-dev from beside this script first (a checkout, or the ~/.local/bin link
# into one), then PATH.
LANE_DEV="$HERE/lane-dev"
[ -x "$LANE_DEV" ] || LANE_DEV="$(command -v lane-dev 2>/dev/null)"

# lane-dev with every slot's lock descriptor closed (LOCK_FDS): a lane-dev,
# or a server it left behind, holding one would hold the slot.
LOCK_FDS=()
lane_dev() {
  ( for v in "${LOCK_FDS[@]}"; do eval "exec $v>&-"; done; exec "$LANE_DEV" "$@" )
}

# IS THE REMOTE HOST UP: an HTTP GET of /json answered 200 within 3 s
# (pw-remote-server.cjs and a plain `playwright run-server` both do). Bash's
# /dev/tcp, so neither curl nor python is needed. Asked twice before it
# counts as down: over the Deck's WiFi one probe in a few dozen took past the
# timeout (measured: a whole run went local on one miss while the PC answered
# every other probe in 60-230 ms). A host that failed both is not asked again
# for a minute -- a sleeping PC costs the full timeout on every 5-second pass
# otherwise -- and that is said once, so a run that went local says why.
declare -A DOWN_UNTIL=()
probe() {
  # shellcheck disable=SC2016  # $0/$1 are the inner bash's, on purpose
  timeout 3 bash -c 'exec 3<>"/dev/tcp/$0/$1" || exit 1
       printf "GET /json HTTP/1.0\r\nHost: %s\r\n\r\n" "$0" >&3; head -c 12 <&3' "$1" "$2" 2>/dev/null \
    | grep -q '^HTTP/1\.[01] 200'
}
remote_ok() {
  local hp="$1" host="${1%:*}" port="${1##*:}"
  [ "${DOWN_UNTIL[$hp]:-0}" -gt "$SECONDS" ] && return 1
  probe "$host" "$port" || probe "$host" "$port" && return 0
  [ -n "${DOWN_UNTIL[$hp]:-}" ] || echo "e2e-slot: remote slot $hp does not answer; skipping it (asked again every minute)" >&2
  DOWN_UNTIL[$hp]=$((SECONDS + 60))
  return 1
}

# IS THE PC HOST UP: e2e-pc.sh probe --quick (ssh answers). Whether it can
# take THIS run is the run's own first step (exit 76 below). Cached like
# remote_ok, per host name.
pc_ok() {
  local name="$1" rc
  [ "${DOWN_UNTIL[pc:$name]:-0}" -gt "$SECONDS" ] && return 1
  "$PC_LIB" probe --quick "$name" 2>/dev/null; rc=$?
  [ "$rc" = 0 ] && return 0
  [ -n "${DOWN_UNTIL[pc:$name]:-}" ] || echo "e2e-slot: pc host $name does not answer or cannot take runs; skipping it (asked again every minute)" >&2
  DOWN_UNTIL[pc:$name]=$((SECONDS + 60))
  return 1
}

# The command's environment on a remote slot: the shim in NODE_OPTIONS (kept
# beside whatever the caller had there) and the server to connect to. Only the
# command gets it -- lane-dev's server is started from `run` without it.
remote_env() {
  local hp="$1"
  export E2E_SLOT_REMOTE="$hp" PW_REMOTE_WS="ws://$hp/"
  export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require \"$SHIM\""
  if [ -n "$REMOTE_GPU" ]; then export PW_REMOTE_GPU="$REMOTE_GPU"; else unset PW_REMOTE_GPU; fi
  echo "e2e-slot: slot $E2E_SLOT is remote: the browser runs on $hp" >&2
}

# The command, with the dev server around it when --dev asked for one. The
# lock descriptors are closed for lane-dev, and lane-dev closes every other
# one for the server too: a server that inherited fd 8 would hold the slot
# for as long as it ran.
run() {
  local rc started=0
  # A pc slot: the whole thing, --dev included, happens over there.
  # A signal here is passed on: e2e-pc.sh then closes the run's lifeline and
  # the far side stops it. Without that a `timeout` around e2e-slot killed only
  # this process, and the run went on over there with its slot released here.
  if [ -n "${E2E_SLOT_PC:-}" ]; then
    local cp
    if [ -n "$DEV_DIR" ]; then "$PC_LIB" run "$E2E_SLOT_PC" --dev "$DEV_DIR" "$DEV_PORT" -- "$@" &
    else "$PC_LIB" run "$E2E_SLOT_PC" -- "$@" & fi
    cp=$!
    trap 'kill -TERM "$cp" 2>/dev/null; wait "$cp" 2>/dev/null; exit 130' INT TERM HUP
    wait "$cp"; rc=$?
    trap - INT TERM HUP
    return "$rc"
  fi
  if [ -n "$DEV_DIR" ]; then
    [ -n "$LANE_DEV" ] || { echo "e2e-slot: --dev needs lane-dev, and none was found" >&2; return 2; }
    if lane_dev status "$DEV_PORT" --quiet; then
      echo "e2e-slot: the dev server on $DEV_PORT was already running; leaving it as it is" >&2
    else
      lane_dev start "$DEV_DIR" "$DEV_PORT" >&2 || return 1
      started=1
      trap 'lane_dev stop "$DEV_PORT" >&2; exit 130' INT TERM HUP
    fi
  fi
  if [ -n "${E2E_SLOT_REMOTE:-}" ]; then ( remote_env "$E2E_SLOT_REMOTE"; exec "$@" ); rc=$?
  else E2E_SLOT_REMOTE="" "$@"; rc=$?; fi
  if [ "$started" = 1 ]; then
    lane_dev stop "$DEV_PORT" >&2
    trap - INT TERM HUP
  fi
  return "$rc"
}

# ONE DESCRIPTOR PER SLOT, opened with {fd} so N is not capped by a list of
# literal numbers. The command must not inherit them: lane-dev already closes
# every descriptor for its server, and `run` closes them for lane-dev.
if [ $EXCL = 1 ]; then
  names=""
  for (( i = 0; i < N; i++ )); do
    exec {fd}>"$(slot_lock "$i")"; flock -w "$WAIT" "$fd" || exit 75
    LOCK_FDS+=("$fd"); names+="$(slot_name "$i")"
  done
  for (( j = 0; j < R; j++ )); do
    exec {fd}>"$(remote_lock "$j")"; flock -w "$WAIT" "$fd" || exit 75
    LOCK_FDS+=("$fd"); names+="$(slot_name $((N + j)))"
  done
  E2E_SLOT="$names" E2E_SLOT_REMOTE="" E2E_SLOT_PC="" run "$@"; exit $?
fi
# The order a pass tries the slots in: "L<i>" local, "R<j>" remote, "P<j>" pc.
ORDER=()
for (( i = 0; i < N; i++ )); do ORDER+=("L$i"); done
if [ "$LOCAL" = 0 ]; then
  for (( j = R - 1; j >= 0; j-- )); do
    if [ "$PREFER" = remote ]; then ORDER=("R$j" "${ORDER[@]}"); else ORDER+=("R$(( R - 1 - j ))"); fi
  done
  for (( j = P - 1; j >= 0; j-- )); do
    if [ "$PREFER" = remote ]; then ORDER=("P$j" "${ORDER[@]}"); else ORDER+=("P$(( P - 1 - j ))"); fi
  done
fi
# Hosts that refused THIS run (exit 76: its tree is theirs, its port is
# taken there): not offered it again.
declare -A PC_NOPE=()
end=$((SECONDS+WAIT))
# --pc-first: only P slots until this moment (or until a pc host is found down).
pcuntil=0
[ "$LOCAL" = 0 ] && [ "$P" -gt 0 ] && [ "$PCFIRST" -gt 0 ] && pcuntil=$((SECONDS + PCFIRST))
while [ $SECONDS -lt $end ]; do
  for s in "${ORDER[@]}"; do
    k="${s#?}"
    pc=""
    case "$s" in P*) ;; *) [ $SECONDS -lt $pcuntil ] && continue ;; esac
    case "$s" in
      L*) lock="$(slot_lock "$k")"; name="$(slot_name "$k")"; hp="" ;;
      R*) lock="$(remote_lock "$k")"; name="$(slot_name $((N + k)))"; hp="${REMOTES[$k]}" ;;
      P*) pc="${PCS[$k]%:*}"; [ -n "${PC_NOPE[$pc]:-}" ] && continue
          lock="$(pc_lock "$k")"; name="$(slot_name $((N + R + k)))"; hp="" ;;
    esac
    exec {fd}>"$lock"
    # The lock first, then the health check: checking first would let two
    # waiters both see the host up and race for one slot, and is no cheaper.
    if flock -n "$fd" && { [ -z "$hp" ] || remote_ok "$hp"; }; then
      if [ -z "$pc" ] || pc_ok "$pc"; then
        LOCK_FDS=("$fd"); E2E_SLOT="$name" E2E_SLOT_REMOTE="$hp" E2E_SLOT_PC="$pc" run "$@"; rc=$?; exec {fd}>&-
        if [ -n "$pc" ] && [ "$rc" = 76 ]; then PC_NOPE[$pc]=1; pcuntil=0; continue; fi
        exit $rc
      fi
      # A pc slot free and its host not answering: asleep or gone. --pc-first
      # stops holding out for it.
      pcuntil=0
    fi
    exec {fd}>&-
  done
  sleep 5
done
echo "e2e-slot: timed out waiting for a slot" >&2; exit 75
