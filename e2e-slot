#!/usr/bin/env bash
# e2e-slot -- run an e2e command in one of TWO machine-wide Playwright slots.
#
#   e2e-slot [--exclusive] [--wait SECS] [--dev <dir> <port>] -- <command...>
#
# Slot A is the classic /tmp/tp-e2e.lock, so old-style `flock /tmp/tp-e2e.lock`
# users share slot A; slot B is /tmp/tp-e2e.lock.b. --exclusive holds BOTH (use
# it for fps/timing measurements). The command sees E2E_SLOT=A, B or AB. Exit
# 75 when no slot came free within --wait seconds (default 5400).
#
# --dev <dir> <port> starts that folder's dev server with `lane-dev` once the
# slot is held, runs the command, and stops the server afterwards -- unless it
# was already running before, in which case it is left as it was (its own idle
# timer still stops it). A server is up only while a run needs it. Why that
# matters is in lane-dev's header.
#
# E2E_SLOT_LOCK moves the two lock files (default /tmp/tp-e2e.lock and
# its .b). It was written for one project's lanes, and those lanes and their
# scripts already name these paths.
set -uo pipefail
EXCL=0; WAIT=5400; DEV_DIR=""; DEV_PORT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --exclusive) EXCL=1; shift ;;
    --wait) WAIT="$2"; shift 2 ;;
    --dev) [ $# -ge 3 ] || { echo "e2e-slot: --dev takes <dir> <port>" >&2; exit 2; }
           DEV_DIR="$2"; DEV_PORT="$3"; shift 3 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: e2e-slot [--exclusive] [--wait S] [--dev DIR PORT] -- cmd" >&2; exit 2; }
A="${E2E_SLOT_LOCK:-/tmp/tp-e2e.lock}"; B="$A.b"; touch "$A" "$B"
# lane-dev from beside this script first (a checkout, or the ~/.local/bin link
# into one), then PATH.
LANE_DEV="$(dirname "$(readlink -f "$0")")/lane-dev"
[ -x "$LANE_DEV" ] || LANE_DEV="$(command -v lane-dev 2>/dev/null)"

# The command, with the dev server around it when --dev asked for one. The
# lock descriptors are closed for lane-dev, and lane-dev closes every other
# one for the server too: a server that inherited fd 8 would hold the slot
# for as long as it ran.
run() {
  local rc started=0
  if [ -n "$DEV_DIR" ]; then
    [ -n "$LANE_DEV" ] || { echo "e2e-slot: --dev needs lane-dev, and none was found" >&2; return 2; }
    if "$LANE_DEV" status "$DEV_PORT" --quiet 8>&- 9>&-; then
      echo "e2e-slot: the dev server on $DEV_PORT was already running; leaving it as it is" >&2
    else
      "$LANE_DEV" start "$DEV_DIR" "$DEV_PORT" 8>&- 9>&- >&2 || return 1
      started=1
      trap '"$LANE_DEV" stop "$DEV_PORT" >&2 8>&- 9>&-; exit 130' INT TERM HUP
    fi
  fi
  "$@"; rc=$?
  if [ "$started" = 1 ]; then
    "$LANE_DEV" stop "$DEV_PORT" 8>&- 9>&- >&2
    trap - INT TERM HUP
  fi
  return "$rc"
}

if [ $EXCL = 1 ]; then
  exec 8>"$A" 9>"$B"; flock -w "$WAIT" 8 || exit 75; flock -w "$WAIT" 9 || exit 75
  E2E_SLOT=AB run "$@"; exit $?
fi
end=$((SECONDS+WAIT))
while [ $SECONDS -lt $end ]; do
  exec 8>"$A"; if flock -n 8; then E2E_SLOT=A run "$@"; rc=$?; exec 8>&-; exit $rc; fi; exec 8>&-
  exec 9>"$B"; if flock -n 9; then E2E_SLOT=B run "$@"; rc=$?; exec 9>&-; exit $rc; fi; exec 9>&-
  sleep 5
done
echo "e2e-slot: timed out waiting for a slot" >&2; exit 75
